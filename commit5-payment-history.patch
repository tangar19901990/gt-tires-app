-        <div><b>Оплачено:</b> ${fmtMoney(o.paidAmount!=null?o.paidAmount:(o.total||0))}</div>
+        <div><b>Оплачено:</b> ${fmtMoney(paidAmount)}</div>
         <div><b>Борг:</b> ${fmtMoney(debtAmount)}</div>
