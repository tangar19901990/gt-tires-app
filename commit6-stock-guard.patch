+  const prevMaterials=(o.materials||[]).map(m=>({id:m.id,name:m.name,qty:m.qty,src:m.src}));
 
   // 2) оновлюємо поля заказу (id / номер / дату не чіпаємо)
   o.clientName=g('oClient').trim();
