+.order-popular-empty{margin-top:8px;padding:10px;border:1px dashed var(--border);border-radius:10px;color:var(--text-dim);font-size:0.76rem}
 .hperiod{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
 .hperiod-btn{padding:7px 15px;border-radius:10px;border:1px solid var(--border);background:var(--black);color:var(--text-dim);font-size:0.8rem;font-weight:600;cursor:pointer}
 .hperiod-btn.active{background:linear-gradient(135deg,var(--red),var(--red-dark));color:#fff;border-color:var(--red)}
