   if(_rem>0){ cashbook.push({id:uid(),date:new Date().toISOString(),type:'income',amount:_rem,method:o.paymentType||'cash',desc:'Замовлення #'+(o.orderNumber||o.id.slice(-5).toUpperCase())+' — '+o.clientName,orderId:o.id}); }
